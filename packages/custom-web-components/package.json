{
  "name": "@surstromming/custom-web-components",
  "version": "0.1.0",
  "description": "Selected components compiled as framework-agnostic custom elements.",
  "license": "MIT",
  "author": "Evgeniy Mnatsakanov <evgeniy.mnatsakanov@gmail.com>",
  "homepage": "https://github.com/hackteck/surstromming/tree/main/packages/custom-web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackteck/surstromming.git",
    "directory": "packages/custom-web-components"
  },
  "bugs": "https://github.com/hackteck/surstromming/issues",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "ui",
    "scss",
    "css-modules",
    "shadcn",
    "custom-web-components"
  ],
  "type": "module",
  "files": [
    "dist/**/*.js",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./src/components/button.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./src/components/input.ts",
      "import": "./dist/input.js"
    },
    "./util": {
      "types": "./src/util.ts",
      "import": "./dist/util.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "preview": "vite build && vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@surstromming/button": "^0.1.0",
    "@surstromming/design": "^0.1.0",
    "@surstromming/input": "^0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.101.0",
    "vite": "^8.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
